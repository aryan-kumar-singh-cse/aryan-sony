{
  "rewrites": [
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/events", "destination": "/api/events.js" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/player", "destination": "/public/player.html" },
    { "source": "/play", "destination": "/public/player.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
